{
  "name": "abap-mcp-standalone",
  "version": "0.41.1",
  "private": true,
  "type": "module",
  "description": "ORVANTA - independent ABAP MCP service for SAP ADT",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "package:windows": "pwsh -NoLogo -NoProfile -File scripts/package-windows.ps1",
    "start": "node dist/src/index.js",
    "settings": "node dist/src/settings-index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "abap-adt-api": "8.4.3",
    "fast-xml-parser": "5.11.0",
    "parse5": "8.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "prettier": "3.6.2",
    "typescript": "5.8.3"
  }
}
