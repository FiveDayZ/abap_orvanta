  "functionName": "SCPR_ACTIV_PROTOCOL_WRITE",
  "sourceFingerprint": "71be29a573260efa559d3fc42f150e12f56187ae44e8569d7eeddb55656f52f7",
  "interfaceFingerprint": "d1bb8eaf7372ef2b71727bfa2389c752218313602607a7f2457f7bcd96c59e3a",
  "source": [
    "FUNCTION scpr_activ_protocol_write.",
    "*\"----------------------------------------------------------------------",
    "*\"*\"Lokale Schnittstelle:",
    "*\"  IMPORTING",
    "*\"     VALUE(CATEGORY) TYPE  SCPR_CTGRY DEFAULT SPACE",
    "*\"  TABLES",
    "*\"      SCPRERRPRT STRUCTURE  SCPRACTERP",
    "*\"----------------------------------------------------------------------",
    "  DATA: line_nr_i    TYPE i  VALUE 0,",
    "        timestart TYPE timestamp,",
    "        timeend   TYPE timestamp.",
    "",
    "  LOOP AT scprerrprt.",
    "*   Header/Endesatz merken",
    "*   if scprerrprt-bcset_id is initial and timestart is initial.",
    "    CLEAR: scpracpp.",
    "    SELECT SINGLE * FROM scpracpp connection R/3*",
    "    WHERE act_id = scprerrprt-act_id.",
    "",
    "    IF sy-subrc <> 0.",
    "      CLEAR glob_line_nr.",
    "      scpracpp-act_id    = scprerrprt-act_id.",
    "      scpracpp-act_date  = scprerrprt-act_date.",
    "      scpracpp-act_time  = scprerrprt-act_time.",
    "      scpracpp-modifier  = scprerrprt-modifier.",
    "      scpracpp-act_type  = scprerrprt-act_type.",
    "      scpracpp-sim_type  = scprerrprt-sim_type.",
    "      scpracpp-t_sid     = sy-sysid.",
    "      scpracpp-t_mandt   = sy-mandt.",
    "      scpracpp-actoptions = scprerrprt-actoptions.",
    "      IF scprerrprt-sysid IS INITIAL.",
    "        scpracpp-sysid = 'lokal'(049).",
    "      ELSE.",
    "        scpracpp-sysid     = scprerrprt-sysid.",
    "      ENDIF.",
    "      CONVERT DATE sy-datum TIME sy-uzeit INTO",
    "                            TIME STAMP timestart TIME ZONE sy-zonlo.",
    "      scpracpp-act_start = timestart.",
    "      INSERT scpracpp connection R/3*.",
    "    ELSE.",
    "      IF scprerrprt-protoflag = 'E'.                        \"(E)ndesatz",
    "        CONVERT DATE sy-datum TIME sy-uzeit INTO",
    "                              TIME STAMP timeend TIME ZONE sy-zonlo.",
    "        scpracpp-act_end = timeend.",
    "        scpracpp-actoptions = scprerrprt-actoptions.",
    "        MODIFY scpracpp connection R/3*.",
    "      ENDIF.",
    "      IF scprerrprt-protoflag = 'R'.                        \"(R)ollback",
    "        scpracpp-act_end = 0.                               \"Display as not finished",
    "        MODIFY scpracpp connection R/3*.",
    "      ENDIF.",
    "      IF NOT scprerrprt-trno_syst IS INITIAL.",
    "        scpracpp-trno_syst = scprerrprt-trno_syst.",
    "        MODIFY scpracpp connection R/3*.",
    "      ENDIF.",
    "      IF NOT scprerrprt-trno_cust IS INITIAL.",
    "        scpracpp-trno_cust = scprerrprt-trno_cust.",
    "        MODIFY scpracpp connection R/3*.",
    "      ENDIF.",
    "      IF NOT scprerrprt-langvector IS INITIAL.",
    "        scpracpp-langvector = scprerrprt-langvector.",
    "        MODIFY scpracpp connection R/3*.",
    "      ENDIF.",
    "    ENDIF.",
    "",
    "* Ggf. den Schlüssel des aktuellen Datensatzes in Tab. scpracpr merken",
    "* Hierbei müssen auch die Parameter tablename und tabletype gefüllt sein",
    "*    IF NOT scprerrprt-tablekey IS INITIAL",
    "*    AND NOT scprerrprt-tablename IS INITIAL.",
    "*      scpracpr-act_id     = scprerrprt-act_id.",
    "*      line_nr_i           = glob_line_nr.",
    "*      line_nr_i           = line_nr_i + 1.",
    "*      glob_line_nr        = line_nr_i.",
    "*      scpracpr-line_nr    = glob_line_nr.",
    "*      scpracpr-objectname = scprerrprt-objectname.",
    "*      scpracpr-tablename  = scprerrprt-tablename.",
    "*      scpracpr-tabletype  = scprerrprt-tabletype.",
    "*      scpracpr-tablekey   = scprerrprt-tablekey.",
    "**   Falls ein Fehler bei diesem Datensatz auftrat, dann Feld err_linenr",
    "**   füllen.",
    "*      IF NOT scprerrprt-msgno IS INITIAL",
    "*        AND NOT scprerrprt-msgid IS INITIAL.",
    "*        scpracpr-err_linenr = scpracpr-line_nr.",
    "*      ELSE.",
    "*        CLEAR scpracpr-err_linenr.",
    "*      ENDIF.",
    "*      INSERT scpracpr.",
    "*    ENDIF.",
    "",
    "* Ein Fehler trat auf und muß in Tab. scpracpm weggeschrieben werden.",
    "* Es sollten mind. die Parameter msgid, msgty und msgno gefüllt sein.",
    "    IF NOT scprerrprt-msgno IS INITIAL",
    "      AND NOT scprerrprt-msgid IS INITIAL.",
    "      scpracpm-act_id  = scprerrprt-act_id.",
    "*      IF scprerrprt-tablekey IS INITIAL.",
    "      line_nr_i        = glob_line_nr.",
    "      line_nr_i        = line_nr_i + 1.",
    "      glob_line_nr     = line_nr_i.",
    "*      ENDIF.",
    "      scpracpm-bcset_id   = scprerrprt-bcset_id.",
    "      scpracpm-parent_id  = scprerrprt-parent_id.",
    "      scpracpm-objectname = scprerrprt-objectname.",
    "      scpracpm-objecttype = scprerrprt-objecttype.",
    "      scpracpm-line_nr    = glob_line_nr.",
    "      scpracpm-msgid      = scprerrprt-msgid.",
    "      scpracpm-msgty      = scprerrprt-msgty.",
    "      scpracpm-msgno      = scprerrprt-msgno.",
    "      scpracpm-var1       = scprerrprt-var1.",
    "      scpracpm-var2       = scprerrprt-var2.",
    "      scpracpm-var3       = scprerrprt-var3.",
    "      scpracpm-var4       = scprerrprt-var4.",
    "      scpracpm-protoflag  = scprerrprt-protoflag.",
    "      INSERT scpracpm connection R/3*.",
    "",
    "      IF NOT scprerrprt-tablekey IS INITIAL",
    "      AND NOT scprerrprt-objectname IS INITIAL.",
    "*      AND NOT scprerrprt-tablename IS INITIAL.",
    "        scpracpr-act_id     = scprerrprt-act_id.",
    "        scpracpr-line_nr    = glob_line_nr.",
    "        scpracpr-objectname = scprerrprt-objectname.",
    "        scpracpr-tablename  = scprerrprt-tablename.",
    "        scpracpr-tabletype  = scprerrprt-tabletype.",
    "",
    "        CONDENSE scprerrprt-tablekey.",
    "        scpracpr-tablekey   = scprerrprt-tablekey.",
    "        INSERT scpracpr connection R/3*.",
    "      ENDIF.",
    "    ENDIF.",
    "    CLEAR scprerrprt.",
    "  ENDLOOP.",
    "* keep DB changes",
    "  commit connection R/3*.",
    "  REFRESH scprerrprt.",
    "ENDFUNCTION."
  ],
  "evidenceSha256": "3a014a51de02ad191e2abaabe8b7614d032fb33853df4744799aaa66387e8d97"
}
