    "source": [
      "FUNCTION RPY_PROGRAM_READ.",
      "*\"----------------------------------------------------------------------",
      "*\"*\"Lokale Schnittstelle:",
      "*\"  IMPORTING",
      "*\"     VALUE(LANGUAGE) LIKE  SY-LANGU DEFAULT SY-LANGU",
      "*\"     VALUE(PROGRAM_NAME) LIKE  RPY_PROG-PROGNAME",
      "*\"     VALUE(WITH_INCLUDELIST) LIKE  RGLIF-WITH_INCL DEFAULT 'X'",
      "*\"     VALUE(ONLY_SOURCE) LIKE  RGLIF-ONLY_SOURC DEFAULT ' '",
      "*\"     VALUE(ONLY_TEXTS) LIKE  RGLIF-ONLY_TEXTS DEFAULT ' '",
      "*\"     VALUE(READ_LATEST_VERSION) TYPE  PROGDIR-STATE DEFAULT SPACE",
      "*\"     VALUE(WITH_LOWERCASE) LIKE  RGLIF-LOWERCASE DEFAULT ' '",
      "*\"  EXPORTING",
      "*\"     VALUE(PROG_INF) LIKE  RPY_PROG STRUCTURE  RPY_PROG",
      "*\"  TABLES",
      "*\"      INCLUDE_TAB STRUCTURE  RPY_REPO OPTIONAL",
      "*\"      SOURCE STRUCTURE  ABAPSOURCE OPTIONAL",
      "*\"      SOURCE_EXTENDED STRUCTURE  ABAPTXT255 OPTIONAL",
      "*\"      TEXTELEMENTS STRUCTURE  TEXTPOOL OPTIONAL",
      "*\"  EXCEPTIONS",
      "*\"      CANCELLED",
      "*\"      NOT_FOUND",
      "*\"      PERMISSION_ERROR",
      "*\"----------------------------------------------------------------------",
      "  data: wb_source type rswsourcet.",
      "  CLEAR TRDIR.",
      "",
      "    SELECT SINGLE * FROM TRDIR WHERE NAME = PROGRAM_NAME.",
      "*                             and   subc ne 'I'.",
      "    IF SY-SUBRC NE 0.                  \"or trdir-subc eq 'I'.",
      "      MESSAGE E004 WITH PROGRAM_NAME RAISING NOT_FOUND.",
      "*      Objekt & wurde nicht gefunden",
      "      EXIT.",
      "    ENDIF.",
      "",
      "  CALL FUNCTION 'RS_ACCESS_PERMISSION'",
      "       EXPORTING",
      "            AUTHORITY_CHECK          = 'X'",
      "            GLOBAL_LOCK              = SPACE",
      "            MODE                     = 'SHOW'",
      "            OBJECT                   = PROGRAM_NAME",
      "            OBJECT_CLASS             = 'ABAP'",
      "       EXCEPTIONS",
      "            CANCELED_IN_CORR         = 01",
      "            ENQUEUED_BY_USER         = 02",
      "            ENQUEUE_SYSTEM_FAILURE   = 03",
      "            ILLEGAL_PARAMETER_VALUES = 04",
      "            LOCKED_BY_AUTHOR         = 05",
      "            NO_MODIFY_PERMISSION     = 06",
      "            NO_SHOW_PERMISSION       = 07",
      "            PERMISSION_FAILURE       = 12.",
      "  CASE SY-SUBRC.",
      "    WHEN 0.",
      "    WHEN 1.",
      "      MESSAGE ID SY-MSGID TYPE  'S'     NUMBER SY-MSGNO",
      "              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4",
      "              RAISING CANCELLED.",
      "    WHEN 12.",
      "      MESSAGE ID SY-MSGID TYPE  'S'     NUMBER SY-MSGNO",
      "              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4",
      "              RAISING PERMISSION_ERROR.",
      "    WHEN OTHERS.",
      "      MESSAGE ID SY-MSGID TYPE  'S'     NUMBER SY-MSGNO",
      "              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4",
      "              RAISING PERMISSION_ERROR.",
      "  ENDCASE.",
      "",
      "*--Berechtigungspruefung",
      "  CALL FUNCTION 'RS_ACCESS_PERMISSION'",
      "       EXPORTING",
      "            AUTHORITY_CHECK          = 'X'",
      "            GLOBAL_LOCK              = SPACE",
      "            MODE                     = 'SHOW'",
      "            OBJECT                   = PROGRAM_NAME",
      "            OBJECT_CLASS             = 'TEXT'",
      "       EXCEPTIONS",
      "            CANCELED_IN_CORR         = 01",
      "            ENQUEUED_BY_USER         = 02",
      "            ENQUEUE_SYSTEM_FAILURE   = 03",
      "            ILLEGAL_PARAMETER_VALUES = 04",
      "            LOCKED_BY_AUTHOR         = 05",
      "            NO_MODIFY_PERMISSION     = 06",
      "            NO_SHOW_PERMISSION       = 07",
      "            PERMISSION_FAILURE       = 12.",
      "  CASE SY-SUBRC.",
      "    WHEN 0.",
      "    WHEN 1.",
      "      MESSAGE ID SY-MSGID TYPE  'S'     NUMBER SY-MSGNO",
      "              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4",
      "              RAISING CANCELLED.",
      "    WHEN 12.",
      "      MESSAGE ID SY-MSGID TYPE  'S'     NUMBER SY-MSGNO",
      "              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4",
      "              RAISING PERMISSION_ERROR.",
      "    WHEN OTHERS.",
      "      MESSAGE ID SY-MSGID TYPE  'S'     NUMBER SY-MSGNO",
      "              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4",
      "              RAISING PERMISSION_ERROR.",
      "  ENDCASE.",
      "",
      "  IF ONLY_TEXTS EQ SPACE.",
      "*--Source lesen",
      "    IF READ_LATEST_VERSION = SPACE.",
      "      IF SOURCE_EXTENDED IS REQUESTED.",
      "        READ REPORT PROGRAM_NAME INTO SOURCE_EXTENDED.",
      "      ELSE.",
      "        READ REPORT PROGRAM_NAME INTO SOURCE.",
      "      ENDIF.",
      "    ELSE.",
      "      IF SOURCE_EXTENDED IS REQUESTED.",
      "        READ REPORT PROGRAM_NAME INTO SOURCE_EXTENDED STATE 'I'.",
      "      ELSE.",
      "        READ REPORT PROGRAM_NAME INTO SOURCE STATE 'I'.",
      "      ENDIF.",
      "      IF SY-SUBRC <> 0.",
      "        IF SOURCE_EXTENDED IS REQUESTED.",
      "          READ REPORT PROGRAM_NAME INTO SOURCE_EXTENDED STATE 'A'.",
      "        ELSE.",
      "          READ REPORT PROGRAM_NAME INTO SOURCE STATE 'A'.",
      "        ENDIF.",
      "      ELSE.",
      "        SELECT SINGLE * FROM PROGDIR INTO CORRESPONDING FIELDS OF TRDIR",
      "                        WHERE NAME = PROGRAM_NAME",
      "                        AND STATE  = 'I'.",
      "      ENDIF.",
      "    ENDIF.",
      "  ENDIF.",
      "*--- Umschlüsseln, falls Kleinbuchstaben nicht erlaubt           \"HT9901",
      "  if WITH_LOWERCASE eq space.",
      "    IF SOURCE_EXTENDED IS REQUESTED.                             \"HT0203",
      "      wb_source[] = SOURCE_EXTENDED[].                           \"HT0203",
      "      CALL FUNCTION 'CREATE_NORMAL_FORMAT'                       \"HT0203",
      "*          EXPORTING                                             \"HT0203",
      "*               CONDENSE_REQUIRED = ' '                          \"HT0203",
      "*               CASE              = 'UPPER'                      \"HT0203",
      "           TABLES                                                \"HT0203",
      "                content           = wb_source.                   \"HT0203",
      "      SOURCE_EXTENDED[] = wb_source[].                           \"HT0203",
      "    else.                                                        \"HT0203",
      "      wb_source[] = source[].",
      "      CALL FUNCTION 'CREATE_NORMAL_FORMAT'",
      "*          EXPORTING",
      "*               CONDENSE_REQUIRED = ' '",
      "*               CASE              = 'UPPER'",
      "           TABLES",
      "                content           = wb_source.",
      "       source[] = wb_source[].",
      "    endif.                                                       \"HT0203",
      "  endif.",
      "*--- Includes lesen",
      "    IF WITH_INCLUDELIST NE SPACE.",
      "      CALL FUNCTION 'RS_GET_ALL_INCLUDES'",
      "           EXPORTING",
      "                PROGRAM             = PROGRAM_NAME",
      "                WITH_INACTIVE_INCLS = 'X'",
      "           TABLES",
      "                INCLUDETAB          = INCLUDETAB",
      "           EXCEPTIONS",
      "                NOT_EXISTENT = 01",
      "                NO_PROGRAM   = 02.",
      "      LOOP AT INCLUDETAB.",
      "        CLEAR INCLUDE_TAB.",
      "        INCLUDE_TAB-INCLNAME = INCLUDETAB.",
      "        CLEAR TTAB.",
      "        READ TEXTPOOL INCLUDETAB-NAME INTO TTAB LANGUAGE LANGUAGE.",
      "        IF SY-SUBRC = 0.",
      "          LOOP AT TTAB WHERE ID = 'R'.",
      "            INCLUDE_TAB-TITLE = TTAB-ENTRY.",
      "            EXIT.",
      "          ENDLOOP.",
      "        ENDIF.",
      "        APPEND INCLUDE_TAB.",
      "      ENDLOOP.",
      "    ENDIF.",
      "",
      "    IF ONLY_SOURCE EQ SPACE.",
      "*--Texte lesen",
      "      READ TEXTPOOL PROGRAM_NAME INTO TEXTELEMENTS LANGUAGE LANGUAGE.",
      "    ENDIF.",
      "",
      "*--TRDIR Struktur auf RPY_PROG konvertieren",
      "      refresh program_interface.",
      "      DESCRIBE TABLE ITGLIF LINES SY-INDEX.",
      "      IF SY-INDEX = 0.",
      "* ITGLIF wird nur noch bei PROGRAM_READ benutzt, deshalb kann optimiert",
      "* werden, Nutzung Tabellenpuffer",
      "*       SELECT * FROM TGLIF INTO TABLE ITGLIF.                 \"HT9910",
      "        SELECT * FROM TGLIF INTO TABLE ITGLIF                  \"HT9910",
      "               where  tab1 = 'TRDIR'.                          \"HT9910",
      "      ENDIF.",
      "*     LOOP AT ITGLIF WHERE TAB1 = 'TRDIR' .                    \"HT9910",
      "      LOOP AT ITGLIF.                                          \"HT9910",
      "        program_interface = itglif.",
      "        append program_interface.",
      "      ENDLOOP.",
      "      CONVERT1 'TRDIR' 'TRDIR' 'PROG_INF'.",
      "",
      "ENDFUNCTION."
    ],
    "fingerprint": "aa5b9c513444e9915b130c3b7b425cb3068d816ff626298a7580c687e41bdc5d",
