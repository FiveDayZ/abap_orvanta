        "source": [
          "FUNCTION trint_append_comm.",
          "*\"----------------------------------------------------------------------",
          "*\"*\"Lokale Schnittstelle:",
          "*\"  IMPORTING",
          "*\"     VALUE(WI_EXCLUSIVE) LIKE  TRPARI-S_LOCKFLAG DEFAULT 'X'",
          "*\"     VALUE(WI_SEL_E071) LIKE  TRPARI-W_E071 DEFAULT ' '",
          "*\"     VALUE(WI_SEL_E071K) LIKE  TRPARI-W_E071K DEFAULT ' '",
          "*\"     VALUE(WI_TRKORR) LIKE  E070-TRKORR",
          "*\"     VALUE(IT_E071K_STR) TYPE  E071K_STRTYP OPTIONAL",
          "*\"  EXPORTING",
          "*\"     VALUE(WE_KEYS_PHYSICAL_APPENDED) LIKE  TRPARI-W_APPEND",
          "*\"     VALUE(WE_OBJECTS_PHYSICAL_APPENDED) LIKE  TRPARI-W_APPEND",
          "*\"  TABLES",
          "*\"      WT_E071 STRUCTURE  E071 OPTIONAL",
          "*\"      WT_E071K STRUCTURE  E071K OPTIONAL",
          "*\"  EXCEPTIONS",
          "*\"      E071K_APPEND_ERROR",
          "*\"      E071_APPEND_ERROR",
          "*\"      TRKORR_EMPTY",
          "*\"----------------------------------------------------------------------",
          "  DATA:   lv_pos                  LIKE e071-as4pos,",
          "          lv_max_pos              LIKE e071-as4pos,",
          "          lv_pgmid_old            LIKE e071k-pgmid,",
          "          lv_object_old           LIKE e071k-object,",
          "          lv_objname_old          LIKE e071k-objname,",
          "          lv_insert_e071          TYPE c       VALUE ' ',",
          "          lv_insert_e071k         TYPE c       VALUE ' ',",
          "          lv_group_already_exists TYPE c       VALUE ' ',",
          "          lv_lines                TYPE i.",
          "",
          "  DATA: lt_e071k                LIKE e071k   OCCURS 0  WITH HEADER LINE,",
          "        lt_e071k_ins            LIKE e071k   OCCURS 0,",
          "        lt_e071_old             LIKE e071    OCCURS 0.",
          "  FIELD-SYMBOLS: <ls_e071>      LIKE e071,",
          "                 <ls_e071k>     LIKE e071k.",
          "",
          "* string key",
          "  DATA: lv_pos_str               TYPE e071k_str-as4pos,",
          "        lv_max_pos_str           TYPE e071k_str-as4pos,",
          "        lt_e071k_str             TYPE TABLE OF e071k_str ,",
          "        ls_e071k_str             TYPE e071k_str,",
          "        lv_insert_e071k_str      TYPE c VALUE ' ',",
          "        lt_e071k_ins_str         TYPE TABLE OF e071k_str  .",
          "",
          "  FIELD-SYMBOLS:   <ls_e071k_str>     TYPE  e071k_str.",
          "",
          "  CLEAR: we_objects_physical_appended, we_keys_physical_appended.",
          "",
          "",
          "*---make sure that order is filled -------------------------------------",
          "  IF wi_trkorr = space.",
          "    MESSAGE e128(tk) RAISING trkorr_empty.",
          "  ENDIF.",
          "",
          "*---append objects -----------------------------------------------------",
          "  IF wi_sel_e071 = 'X'.",
          "",
          "*---find highest position in E071",
          "    SELECT as4pos FROM e071 INTO lv_max_pos",
          "                  WHERE trkorr = wi_trkorr",
          "                  ORDER BY as4pos DESCENDING.",
          "      EXIT.",
          "    ENDSELECT.",
          "    IF sy-subrc <> 0. lv_max_pos = 0. ENDIF.",
          "",
          "*---no object twice in object list--------------------------------------",
          "    IF   wi_exclusive   ><   space.",
          "",
          "      DESCRIBE TABLE wt_e071 LINES lv_lines.",
          "      IF lv_lines > 0.",
          "",
          "* 'select for all entries' gets expensive if table lt_e071_old is big",
          "        IF lv_lines < 10.",
          "          SELECT * FROM e071 INTO TABLE lt_e071_old",
          "                             FOR ALL ENTRIES IN wt_e071",
          "                             WHERE pgmid      = wt_e071-pgmid",
          "                             AND   object     = wt_e071-object",
          "                             AND   obj_name   = wt_e071-obj_name",
          "                             AND   objfunc    = wt_e071-objfunc",
          "                             AND   lockflag   = wt_e071-lockflag",
          "                             AND   activity   = wt_e071-activity",
          "                             AND   lang       = wt_e071-lang",
          "                             AND   trkorr     = wi_trkorr.",
          "        ELSE.",
          "          SELECT * FROM e071 INTO TABLE lt_e071_old",
          "                             WHERE trkorr = wi_trkorr.",
          "        ENDIF.",
          "",
          "        DESCRIBE TABLE lt_e071_old LINES lv_lines.",
          "        IF lv_lines > 0.",
          "          SORT lt_e071_old  BY pgmid object obj_name objfunc",
          "                               lockflag activity lang.",
          "          LOOP AT wt_e071 ASSIGNING <ls_e071>.",
          "            READ TABLE lt_e071_old TRANSPORTING NO FIELDS BINARY SEARCH",
          "                          WITH KEY pgmid     = <ls_e071>-pgmid",
          "                                   object    = <ls_e071>-object",
          "                                   obj_name  = <ls_e071>-obj_name",
          "                                   objfunc   = <ls_e071>-objfunc",
          "                                   lockflag  = <ls_e071>-lockflag",
          "                                   activity  = <ls_e071>-activity",
          "                                   lang      = <ls_e071>-lang.",
          "            IF sy-subrc = 0.",
          "              DELETE wt_e071.",
          "            ENDIF.",
          "          ENDLOOP.",
          "        ENDIF.",
          "",
          "        IF NOT wt_e071[] IS INITIAL.",
          "          lv_insert_e071 = 'X'.",
          "        ENDIF.",
          "",
          "      ENDIF.",
          "",
          "    ELSE.",
          "      IF NOT wt_e071[] IS INITIAL.",
          "        lv_insert_e071 = 'X'.",
          "      ENDIF.",
          "    ENDIF.",
          "",
          "    IF lv_insert_e071 = 'X'.",
          "      lv_pos = lv_max_pos.",
          "",
          "      LOOP AT wt_e071 ASSIGNING <ls_e071>.",
          "        lv_pos           =    lv_pos + 1.",
          "        <ls_e071>-trkorr =    wi_trkorr.",
          "        <ls_e071>-as4pos =    lv_pos.",
          "* 2008.6 Hinweise 1173582. For R3TR object  E071.LANG must be SPACE.",
          "        IF <ls_e071>-pgmid = 'R3TR' AND <ls_e071>-lang <>  space",
          "          OR <ls_e071>-pgmid = 'LIMU' AND <ls_e071>-lang <> space.",
          "          <ls_e071>-lang  =  space.",
          "        ENDIF.",
          "      ENDLOOP.",
          "",
          "*---- database insert of E071 (if insert fails, you get a runtime error)",
          "      INSERT e071 FROM TABLE wt_e071.",
          "",
          "      we_objects_physical_appended = 'X'.",
          "    ENDIF.",
          "  ENDIF.",
          "",
          "",
          "*---append keys at E071K and E071K_STR------------------------------------",
          "  IF wi_sel_e071k = 'X'.",
          "    IF wt_e071k[] IS NOT INITIAL.",
          "",
          "* append to E071K : conventional key.",
          "      CLEAR: lv_insert_e071k, lv_pgmid_old, lv_object_old, lv_objname_old,",
          "             lt_e071k_ins[].",
          "",
          "      SORT wt_e071k BY pgmid object objname tabkey.",
          "",
          "      LOOP AT wt_e071k ASSIGNING <ls_e071k>.",
          "* 2008.8 Note 1173582. For R3TR/LIMU object  E071K.LANG must be SPACE.",
          "        IF <ls_e071k>-pgmid = 'R3TR' AND <ls_e071k>-lang <> space",
          "           OR <ls_e071k>-pgmid = 'LIMU' AND <ls_e071k>-lang <> space.",
          "          <ls_e071k>-lang  =  space.",
          "        ENDIF.",
          "        <ls_e071k>-trkorr = wi_trkorr.",
          "        IF   <ls_e071k>-pgmid      ><   lv_pgmid_old",
          "        OR   <ls_e071k>-object     ><   lv_object_old",
          "        OR   <ls_e071k>-objname    ><   lv_objname_old.",
          "          lv_pgmid_old   = <ls_e071k>-pgmid.",
          "          lv_object_old  = <ls_e071k>-object.",
          "          lv_objname_old = <ls_e071k>-objname.",
          "",
          "*---database insert E071K for one group (same pgmid & object & objname)",
          "*   if insert fails you get a runtime error",
          "          IF   lv_insert_e071k    =    'X'.",
          "            INSERT e071k FROM TABLE lt_e071k_ins.",
          "            we_keys_physical_appended = 'X'.",
          "          ENDIF.",
          "",
          "*---get existing E071K for one group------------------------------------",
          "          REFRESH: lt_e071k, lt_e071k_ins.",
          "          SELECT * FROM e071k INTO TABLE lt_e071k",
          "                              WHERE trkorr   = wi_trkorr",
          "                              AND   pgmid    = <ls_e071k>-pgmid",
          "                              AND   object   = <ls_e071k>-object",
          "                              AND   objname  = <ls_e071k>-objname",
          "                              ORDER BY PRIMARY KEY.",
          "",
          "*---get next position in E071K------------------------------------------",
          "          CLEAR: lv_pos, lv_group_already_exists, lv_insert_e071k.",
          "          DESCRIBE TABLE lt_e071k LINES lv_lines.",
          "          IF lv_lines > 0.",
          "            lv_group_already_exists  = 'X'.",
          "            READ TABLE lt_e071k INDEX lv_lines.",
          "            lv_pos     =    lt_e071k-as4pos.",
          "          ENDIF.",
          "",
          "          SORT lt_e071k BY tabkey pgmid mastertype mastername viewname",
          "                         activity lang.",
          "        ENDIF.",
          "",
          "*---fill internal table for insert--------------------------------------",
          "        IF  lv_group_already_exists =  'X'",
          "        AND wi_exclusive            >< space.",
          "          READ TABLE lt_e071k TRANSPORTING NO FIELDS",
          "                      WITH KEY tabkey     = <ls_e071k>-tabkey",
          "                               pgmid      = <ls_e071k>-pgmid",
          "                               mastertype = <ls_e071k>-mastertype",
          "                               mastername = <ls_e071k>-mastername",
          "                               viewname   = <ls_e071k>-viewname",
          "                               activity   = <ls_e071k>-activity",
          "                               lang       = <ls_e071k>-lang",
          "                               BINARY SEARCH.",
          "          IF sy-subrc <> 0.",
          "            lv_insert_e071k   = 'X'.",
          "            lv_pos            = lv_pos + 1.",
          "            <ls_e071k>-as4pos = lv_pos.",
          "            APPEND <ls_e071k> TO lt_e071k_ins.",
          "          ENDIF.",
          "        ELSE.",
          "          lv_insert_e071k   = 'X'.",
          "          lv_pos            = lv_pos + 1.",
          "          <ls_e071k>-as4pos = lv_pos.",
          "          APPEND <ls_e071k> TO lt_e071k_ins.",
          "        ENDIF.",
          "      ENDLOOP.",
          "",
          "*---database insert E071K for last group (same pgmid & object & objname)",
          "*   if insert fails, you get a runtime error",
          "      IF   lv_insert_e071k    =    'X'.",
          "        INSERT e071k FROM TABLE lt_e071k_ins.",
          "        we_keys_physical_appended = 'X'.",
          "      ENDIF.",
          "    ENDIF.",
          "",
          "    IF it_e071k_str IS NOT INITIAL.",
          "* append key to E071K_STR",
          "",
          "      CLEAR: lv_insert_e071k_str, lv_pgmid_old, lv_object_old,",
          "  lv_objname_old, lt_e071k_ins_str[].",
          "",
          "      SORT it_e071k_str BY pgmid object objname tabkey.",
          "",
          "      LOOP AT it_e071k_str ASSIGNING <ls_e071k_str>.",
          "        <ls_e071k_str>-trkorr = wi_trkorr.",
          "        IF   <ls_e071k_str>-pgmid      ><   lv_pgmid_old",
          "        OR   <ls_e071k_str>-object     ><   lv_object_old",
          "        OR   <ls_e071k_str>-objname    ><   lv_objname_old.",
          "          lv_pgmid_old   = <ls_e071k_str>-pgmid.",
          "          lv_object_old  = <ls_e071k_str>-object.",
          "          lv_objname_old = <ls_e071k_str>-objname.",
          "",
          "*---database insert E071K for one group (same pgmid & object & objname)",
          "*   if insert fails you get a runtime error",
          "          IF   lv_insert_e071k_str    =    'X'.",
          "            INSERT e071k_str FROM TABLE lt_e071k_ins_str.",
          "            we_keys_physical_appended = 'X'.",
          "          ENDIF.",
          "",
          "*---get existing E071K for one group------------------------------------",
          "          REFRESH: lt_e071k_str, lt_e071k_ins_str.",
          "          SELECT * FROM e071k_str INTO TABLE lt_e071k_str",
          "                              WHERE trkorr   = wi_trkorr",
          "                              AND   pgmid    = <ls_e071k_str>-pgmid",
          "                              AND   object   = <ls_e071k_str>-object",
          "                              AND   objname  = <ls_e071k_str>-objname",
          "                              ORDER BY PRIMARY KEY.",
          "",
          "*---get next position in E071K_str-------------------------------------",
          "          CLEAR: lv_pos_str, lv_group_already_exists,",
          "lv_insert_e071k_str.",
          "          DESCRIBE TABLE lt_e071k_str LINES lv_lines.",
          "          IF lv_lines > 0.",
          "            lv_group_already_exists  = 'X'.",
          "            READ TABLE lt_e071k_str  INTO ls_e071k_str INDEX lv_lines.",
          "            lv_pos_str     =    ls_e071k_str-as4pos.",
          "          ENDIF.",
          "        ENDIF.",
          "",
          "*---fill internal table for insert--------------------------------------",
          "        IF  lv_group_already_exists =  'X'",
          "        AND wi_exclusive            >< space.",
          "          READ TABLE lt_e071k_str TRANSPORTING NO FIELDS",
          "                        WITH KEY tabkey     = <ls_e071k_str>-tabkey",
          "                                 pgmid      = <ls_e071k_str>-pgmid",
          "                                 mastertype = <ls_e071k_str>-mastertype",
          "                                 mastername = <ls_e071k_str>-mastername",
          "                                 viewname   = <ls_e071k_str>-viewname",
          "                                 activity   = <ls_e071k_str>-activity",
          "                                 lang       = <ls_e071k_str>-lang.",
          "          IF sy-subrc <> 0.",
          "            lv_insert_e071k_str   = 'X'.",
          "            lv_pos_str            = lv_pos_str + 1.",
          "            <ls_e071k_str>-as4pos = lv_pos_str.",
          "            APPEND <ls_e071k_str> TO lt_e071k_ins_str.",
          "          ENDIF.",
          "        ELSE.",
          "          lv_insert_e071k_str   = 'X'.",
          "          lv_pos_str            = lv_pos_str + 1.",
          "          <ls_e071k_str>-as4pos = lv_pos_str.",
          "          APPEND <ls_e071k_str> TO lt_e071k_ins_str.",
          "        ENDIF.",
          "      ENDLOOP.",
          "",
          "*---database insert E071K for last group (same pgmid & object & objname)",
          "*   if insert fails, you get a runtime error",
          "      IF   lv_insert_e071k_str    =    'X'.",
          "        INSERT e071k_str FROM TABLE lt_e071k_ins_str.",
          "        we_keys_physical_appended = 'X'.",
          "      ENDIF.",
          "    ENDIF.",
          "  ENDIF.",
          "",
          "ENDFUNCTION."
        ],
        "fingerprint": "1c685584241c30cb8d20f143c3dd449933cd0712e9fa93b38b7ffaead49c2890",
        "interfaceFingerprint": "93114e86ef712a443fbd91693965f2ffc62db2a7937fef9f206e9f013d4b413e",
        "sourceFingerprint": "bfd0cf5793fc887c6f76778d7ac50cbf8e3d469abe4371df41afcc0af3f99e52"
      }
    }
  ],
