        "functionGroup": "SNR2",
        "shortText": "插入和改变数据范围对象",
        "remoteMode": "",
        "updateTask": false,
        "updateTaskMode": "",
        "globalInterface": false,
        "remoteEnabled": false,
        "importParameters": [
          {
            "name": "INDICATOR",
