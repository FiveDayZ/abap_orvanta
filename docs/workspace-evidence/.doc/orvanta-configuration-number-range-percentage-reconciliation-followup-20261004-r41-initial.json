          }
        ],
        "source": [
          "function number_range_object_update.",
          "*\"----------------------------------------------------------------------",
          "*\"*\"Lokale Schnittstelle:",
          "*\"  IMPORTING",
          "*\"     VALUE(INDICATOR) DEFAULT 'U'",
          "*\"     VALUE(OBJECT_ATTRIBUTES) LIKE  TNRO STRUCTURE  TNRO DEFAULT",
          "*\"       SPACE",
          "*\"     VALUE(OBJECT_TEXT) LIKE  TNROT STRUCTURE  TNROT DEFAULT SPACE",
          "*\"  EXPORTING",
          "*\"     VALUE(RETURNCODE)",
          "*\"  TABLES",
          "*\"      ERRORS STRUCTURE  INOER",
          "*\"  EXCEPTIONS",
          "*\"      OBJECT_ALREADY_EXISTS",
          "*\"      OBJECT_ATTRIBUTES_MISSING",
          "*\"      OBJECT_NOT_FOUND",
          "*\"      OBJECT_TEXT_MISSING",
          "*\"      WRONG_INDICATOR",
          "*\"----------------------------------------------------------------------",
          "  data: l_upd_object   type tnro-object,",
          "        l_upd_language type tnrot-langu,",
          "        l_want_update  type c.",
          "",
          "  l_upd_language = sy-langu.",
          "",
          "* prüfen, ob Schnittstelle konsistent übergeben wurde",
          "  case indicator.",
          "    when 'T'.",
          "      if object_text       = space.",
          "*       Bei Textänderung muß ein Textsatz übergeben werden",
          "        message e876 raising object_text_missing.",
          "      endif.",
          "      l_upd_object = object_text-object.",
          "    when 'U' or 'D'.",
          "      if object_attributes = space.",
          "*       Bei Objektänderung muß ein Objektsatz übergeben werden",
          "        message e875 raising object_attributes_missing.",
          "      endif.",
          "      l_upd_object = object_attributes-object.",
          "    when 'I'.",
          "      if object_attributes = space.",
          "*       Beim Erfassen muß ein Objekt- und ein Textsatz",
          "*       übergeben werden",
          "        message e875 raising object_attributes_missing.",
          "      endif.",
          "      if object_text       = space.",
          "*       Beim Erfassen muß ein Objekt- und ein Textsatz",
          "*       übergeben werden",
          "        message e876 raising object_text_missing.",
          "      endif.",
          "      l_upd_object = object_attributes-object.",
          "    when others.",
          "*     falsches Verarbeitungskennzeichen",
          "      raise wrong_indicator.",
          "  endcase.",
          "",
          "  if g_tnro_act-object <> l_upd_object.",
          "    call function 'NUMBER_RANGE_OBJECT_INIT'",
          "         exporting",
          "           language         = l_upd_language",
          "           object           = l_upd_object",
          "         exceptions",
          "           object_not_found = 1.",
          "    if indicator = 'I'.",
          "*     Objekt soll erfaßt werden, Objekt darf nicht vorhanden sein",
          "      if sy-subrc = 0.",
          "*       Objekt bereits vorhanden",
          "        message s877 with l_upd_object",
          "                raising object_already_exists.",
          "      endif.",
          "    elseif indicator = 'U'.",
          "*     Objekt soll geändert werden, Objekt muß vorhanden sein",
          "      if sy-subrc ne 0.",
          "        message s870 raising object_not_found.",
          "      endif.",
          "    endif.",
          "  endif.",
          "",
          "  if object_attributes-textind <> space.",
          "    object_attributes-textind = 'X'.",
          "  endif.",
          "",
          "  returncode = space.",
          "* Objekt soll erfaßt oder geändert werden",
          "  perform check_object",
          "          tables   errors            \"Import",
          "          using    object_attributes",
          "                   object_text",
          "                   indicator",
          "          changing returncode.",
          "  l_want_update = yes.",
          "  if returncode = c_warning_occured and g_dialog = yes.",
          "    returncode = space.",
          "    loop at errors where fieldname <> 'NRELTXTTAB' and",
          "                         fieldname <> 'NRELTXTSOB' and",
          "                         fieldname <> 'NRELTXTELE' and",
          "                         fieldname <> 'NRELTXTTXT' and",
          "                         fieldname <> 'NRELTXTLNG'.",
          "      message id       errors-msgid",
          "              type     'S'",
          "              number   errors-msgnumber",
          "              with errors-msgvar1 errors-msgvar2",
          "                   errors-msgvar3 errors-msgvar4.",
          "      perform send_warning",
          "              using    errors-critchange",
          "              changing l_want_update.",
          "      case l_want_update.",
          "        when no.",
          "          case errors-fieldname.",
          "            when 'DTELSOBJ'.",
          "              tnro-dtelsobj  = g_tnro_act-dtelsobj.",
          "            when 'YEARIND'.",
          "              tnro-yearind   = g_tnro_act-yearind.",
          "            when 'DOMLEN'.",
          "              tnro-domlen    = g_tnro_act-domlen.",
          "            when others.",
          "              if errors-fieldname = 'NRTAB'      or",
          "                 errors-fieldname = 'NRINTFLD'   or",
          "                 errors-fieldname = 'NREXTFLD'   or",
          "                 errors-fieldname = 'NRFLD'      or",
          "                 errors-fieldname = 'NRSOBJFLD'  or",
          "                 errors-fieldname = 'NRELEFLD'.",
          "                tnro-nrtab     = g_tnro_act-nrtab.",
          "                tnro-nrintfld  = g_tnro_act-nrintfld.",
          "                tnro-nrextfld  = g_tnro_act-nrextfld.",
          "                tnro-nrfld     = g_tnro_act-nrfld.",
          "                tnro-nrsobjfld = g_tnro_act-nrsobjfld.",
          "                tnro-nrelefld  = g_tnro_act-nrelefld.",
          "              endif.",
          "          endcase.",
          "             returncode = c_warning_occured.",
          "        when c_cancel_work.",
          "             returncode = c_warning_occured.",
          "             exit.",
          "        when yes.",
          "          case errors-fieldname.",
          "            when 'DTELSOBJ'.",
          "              g_tnro_act-dtelsobj = object_attributes-dtelsobj.",
          "            when 'YEARIND'.",
          "              g_tnro_act-yearind  = object_attributes-yearind.",
          "            when 'DOMLEN'.",
          "              g_tnro_act-domlen   = object_attributes-domlen.",
          "            when others.",
          "              if errors-fieldname = 'NRTAB'      or",
          "                 errors-fieldname = 'NRINTFLD'   or",
          "                 errors-fieldname = 'NREXTFLD'   or",
          "                 errors-fieldname = 'NRFLD'      or",
          "                 errors-fieldname = 'NRSOBJFLD'  or",
          "                 errors-fieldname = 'NRELEFLD'.",
          "                g_tnro_act-nrtab     = object_attributes-nrtab.",
          "                g_tnro_act-nrintfld  = object_attributes-nrintfld.",
          "                g_tnro_act-nrextfld  = object_attributes-nrextfld.",
          "                g_tnro_act-nrfld     = object_attributes-nrfld.",
          "                *tnro                = object_attributes.",
          "                g_tnro_act-nrsobjfld = tnro-nrsobjfld.",
          "                g_tnro_act-nrelefld  = object_attributes-nrelefld.",
          "             endif.",
          "          endcase.",
          "          delete errors.",
          "      endcase.",
          "    endloop.",
          "    loop at errors where fieldname = 'NRELTXTTAB' or",
          "                         fieldname = 'NRELTXTSOB' or",
          "                         fieldname = 'NRELTXTELE' or",
          "                         fieldname = 'NRELTXTTXT' or",
          "                         fieldname = 'NRELTXTLNG'.",
          "      returncode = c_warning_occured.",
          "      exit.",
          "    endloop.",
          "  endif.",
          "",
          "  if returncode = space or",
          "     ( returncode = c_warning_occured and g_dialog = no ).",
          "*   neues Objekt ist ok oder alle Warnungen bestätigt",
          "    if indicator = 'I'.",
          "      clear g_tnro_act.",
          "      clear tnro_old.",
          "      refresh xtnrot.",
          "      refresh ytnrot.",
          "      clear g_tnrot_act.",
          "      clear g_tnrot_old.",
          "      xtnrot    = object_text.",
          "      xtnrot-kz = 'I'.",
          "      append xtnrot.",
          "    else.",
          "      if object_text ne space.",
          "         read table xtnrot with key langu = object_text-langu",
          "                           binary search.",
          "        case sy-subrc.",
          "          when 0.",
          "            if xtnrot-txtshort <> object_text-txtshort or",
          "               xtnrot-txt      <> object_text-txt.",
          "              xtnrot    = object_text.",
          "              xtnrot-kz = 'U'.",
          "              modify xtnrot index sy-tabix.",
          "            else.",
          "              clear xtnrot-kz.",
          "              modify xtnrot index sy-tabix.",
          "            endif.",
          "          when 4.",
          "            xtnrot    = object_text.",
          "            xtnrot-kz = 'I'.",
          "            insert xtnrot index sy-tabix.",
          "          when 8.",
          "            xtnrot    = object_text.",
          "            xtnrot-kz = 'I'.",
          "            append xtnrot.",
          "        endcase.",
          "      endif.",
          "    endif.",
          "    g_tnro_act   = object_attributes.",
          "    g_tnrot_act  = object_text.",
          "  else.",
          "*   neues Objekt ist nicht ok, es erfolgt keine Übernahme",
          "    if indicator = 'I'.",
          "      perform clear_memory.",
          "    endif.",
          "  endif.",
          "endfunction."
        ],
        "fingerprint": "e5cec81033734b5a89907390d5b6e468f5e8e319e2f5377f04d039ccf0aa6256",
        "interfaceFingerprint": "6785a69fa5364989a552e95c91c14bc2d27a0414c8f102b49dd1f88039de78f9",
        "sourceFingerprint": "3e9fc21e2c8dc8717685c260df5113ddf5a6b5079ffeea5c54b0e5091e4a3f7d"
      }
