  "schemas": [
    {
      "name": "read_ddic_structure",
      "description": "Read one active SAP Dictionary structure, including component data elements, package, concurrency version, and SHA-256 definition fingerprint. An append structure is a structure whose tableClass is APPEND; for it the response also carries baseTable, the table it is attached to (empty for a plain structure). Read-only and allowed for customer or standard objects. A read that completes and finds nothing answers with status \"not-found\", exists false and authoritative true instead of failing, so a missing object is distinguishable from a broken helper; every other failure is still reported as an error.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "objectName": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          }
        },
        "required": [
          "objectName",
          "connectionId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "read_abap_table",
      "description": "Read a bounded single active transparent DDIC table with up to 1024 explicit columns or columns=[\"*\"] for all fields, and structured AND filters. For compatibility with existing Classic BAdI diagnostics, tableName=SXCI is an explicit repository projection rather than a physical DDIC table: it exposes EXIT_NAME, IMP_NAME, CLASS_NAME, and INTER_NAME through read_classic_badi_definition, and an EXIT_NAME EQ filter uses an exact definition read. A confirmed DDIC_OBJECT_NOT_FOUND result for every other name fails as TABLE_QUERY_TABLE_NOT_FOUND and never falls through to an RFC reader. No joins, aggregates, paging, sorting, client override or writes. ADT first; only known empty HTML permits fingerprint-verified RFC readers. If the ADT dictionary endpoint itself is unavailable, a fingerprint-verified RFC metadata path is limited to explicit <=512-character projections and character/date/time fields; when the legacy reader cannot supply whole-layout metadata or reports DATA_BUFFER_EXCEEDED, the separately fingerprint-verified aligned reader is tried once. Authorization failures never retry, and an aligned-reader failure closes the path. columns=[\"*\"], numeric, byte, deep and wide projections fail closed, and tableClassVerified=false makes the missing independent table-class proof explicit. Mixed flat layouts with ADT metadata support character, date, time and numeric text output; numeric values remain SAP strings without JavaScript precision loss. Filters and keys must be character-like; byte/deep projections are rejected, never omitted. Wide rows use <=512-character chunks joined by the entire DDIC primary key and two equal observations; changed/missing/duplicate rows or numeric overflow fail without partial data. Whole-row bounds and a 256-data-call budget apply; reduce maxRows if exceeded. Maximum 500 rows, ordering unspecified and snapshot=false. Authorization and SAP session client handling apply. tableName must be in the D5-2 allowlist (default deny); the allowed tables are ADMI_FILES, ADMI_RUN, AGR_1251, AGR_1252, AGR_PROF, AGR_TCODES, AGR_USERS, ALALERTDB, ARFCSSTATE, D010INC, DD01L, DD02L, DD03L, DD04L, DD07L, DD30L, DD30V, DD31S, DD31V, DD32P, DD32S, DD33S, DD33V, E070, E071, E07T, EDIDC, EDIDS, FPINTERFACE, FPINTERFACET, FPLAYOUT, FPLAYOUTT, SOST, STXH, STXL, STXSCHAR, STXSHEAD, STXSPARA, STXSTAB, SXCI, T000, T001, T001W, T002, T005, T005T, T006, T006A, TADIR, TBATG, TBTCO, TBTCP, TFDIR, TPFHT, TPFYPROPTY, TRFCQIN, TRFCQOUT, TRFCQSTATE, TSP01, TSP02, TSTC, TSTCT, USOBT, USOBT_C, USOBX, USOBX_C, UST04, UST10C, UST10S, VARID, VBHDR, ZTPMC_BZWL. Any other tableName fails as TABLE_NOT_ALLOWED before any SAP access, and the sensitive tables USR02, USR01, PA0001, PA0008, BSEG, CDHRS are never allowed. This bounded reader does not mean unrestricted native free-form querying is available.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "tableName": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,29}$"
          },
          "columns": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/properties/tableName"
                },
                {
                  "type": "string",
                  "const": "*"
                }
              ]
            },
            "minItems": 1,
            "maxItems": 1024
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "$ref": "#/properties/tableName"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "EQ",
                    "NE",
                    "LT",
                    "LE",
                    "GT",
                    "GE"
                  ]
                },
                "value": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "required": [
                "column",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 8,
            "default": []
          },
          "maxRows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "required": [
          "connectionId",
          "tableName",
          "columns"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
