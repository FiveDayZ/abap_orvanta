        "source": [
          "FUNCTION CALCULATE_HASH_FOR_RAW.",
          "*\"----------------------------------------------------------------------",
          "*\"*\"Lokale Schnittstelle:",
          "*\"  IMPORTING",
          "*\"     VALUE(ALG) TYPE  HASHALG DEFAULT 'SHA1'",
          "*\"     REFERENCE(DATA) TYPE  XSTRING",
          "*\"     VALUE(LENGTH) TYPE  I DEFAULT 0",
          "*\"  EXPORTING",
          "*\"     VALUE(HASH) TYPE  HASH160",
          "*\"     VALUE(HASHLEN) TYPE  I",
          "*\"     VALUE(HASHX) TYPE  HASH160X",
          "*\"     VALUE(HASHXLEN) TYPE  I",
          "*\"     REFERENCE(HASHSTRING) TYPE  STRING",
          "*\"     REFERENCE(HASHXSTRING) TYPE  XSTRING",
          "*\"     REFERENCE(HASHB64STRING) TYPE  STRING",
          "*\"  EXCEPTIONS",
          "*\"      UNKNOWN_ALG",
          "*\"      PARAM_ERROR",
          "*\"      INTERNAL_ERROR",
          "*\"----------------------------------------------------------------------",
          "  DATA: lf_opcode TYPE x VALUE snt_ab_opcode_genhashblob.",
          "  IF hashstring IS REQUESTED.",
          "    hashstring    = snt_ab_is_requested_c.",
          "    lf_opcode     = snt_ab_opcode_hashblobext.",
          "  ENDIF.",
          "  IF hashxstring IS REQUESTED.",
          "    hashxstring   = snt_ab_is_requested_x.",
          "    lf_opcode     = snt_ab_opcode_hashblobext.",
          "  ENDIF.",
          "  IF hashb64string IS REQUESTED.",
          "    hashb64string = snt_ab_is_requested_c.",
          "    lf_opcode     = snt_ab_opcode_hashblobext.",
          "  ENDIF.",
          "* Hashwert aus Data ohne Konvertierung berechnen",
          "  CALL 'SNC_ABAP_SERVICE'                                 \"#EC CI_CCALL",
          "    ID 'OPCODE'       FIELD lf_opcode",
          "    ID 'ALG'          FIELD alg",
          "    ID 'BLOBXSTR'     FIELD data",
          "    ID 'BLOBLEN'      FIELD length",
          "    ID 'HASH'         FIELD hash      \"obsolete",
          "    ID 'HASHLEN'      FIELD hashlen   \"obsolete",
          "    ID 'HASHX'        FIELD hashx     \"obsolete",
          "    ID 'HASHXLEN'     FIELD hashxlen  \"obsolete",
          "    ID 'HASHCSTR'     FIELD hashstring",
          "    ID 'HASHXSTR'     FIELD hashxstring",
          "    ID 'HASHB64CSTR'  FIELD hashb64string.",
          "",
          "  IF sy-subrc <> 0.",
          "    CLEAR: hashstring,hashxstring,hashb64string.",
          "    CASE sy-subrc.",
          "      WHEN 2.      MESSAGE e008(md5) RAISING internal_error.",
          "      WHEN 8.      MESSAGE e005(md5) RAISING param_error.",
          "      WHEN 12.     MESSAGE e020(md5) RAISING param_error.",
          "      WHEN 16.     MESSAGE e004(md5) WITH alg RAISING unknown_alg.",
          "      WHEN OTHERS. MESSAGE e006(md5) RAISING internal_error.",
          "    ENDCASE.",
          "  ENDIF.",
          "",
          "ENDFUNCTION."
        ],
