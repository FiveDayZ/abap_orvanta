        "source": [
          "function number_range_update_init.",
          "*\"----------------------------------------------------------------------",
          "*\"*\"Lokale Schnittstelle:",
          "*\"  IMPORTING",
          "*\"     VALUE(OBJECT) LIKE  TNRO-OBJECT",
          "*\"  EXCEPTIONS",
          "*\"      OBJECT_NOT_FOUND",
          "*\"----------------------------------------------------------------------",
          "data: l_domain     type dd03p-domname,",
          "      l_dummytab   type dd01v-entitytab,",
          "      l_returncode type c.",
          "data: l_err        type table of inoer,",
          "      l_err_wa     type inoer.",
          "",
          "* interne Tabellen, Strukturen und Felder initialisieren",
          "  clear iobject.",
          "  xinrg_modified     =",
          "  xtnrgt_modified    =",
          "  xnriv_modified     =",
          "  g_group_read       =",
          "  g_interval_read    =",
          "  g_elementtext_read = no.",
          "  refresh: yinrg,   xinrg,   ytnrgt, xtnrgt, ynriv, xnriv, nriv_sobj,",
          "           ynriv_l, xnriv_l.",
          "*          nriv_sobj_l.",
          "",
          "  clear tnro.",
          "  select single * from tnro where object = object.",
          "  if sy-subrc <> 0.",
          "    message e002 with object raising object_not_found.",
          "  endif.",
          "  clear tnrot.",
          "  select single * from  tnrot",
          "                  where langu  = sy-langu",
          "                    and object = object.",
          "  g_object_init = yes.",
          "* Elemente mit Texten anzeigen: Textangaben ok?",
          "  if tnro-textind = yes.",
          "    call function 'NUMBER_RANGE_OBJECT_UPDATE'",
          "         exporting",
          "           indicator                 = 'U'",
          "           object_attributes         = tnro",
          "           object_text               = tnrot",
          "         importing",
          "           returncode                = l_returncode",
          "         tables",
          "           errors                    = l_err",
          "         exceptions",
          "           object_already_exists     = 0",
          "           object_attributes_missing = 0",
          "           object_not_found          = 0",
          "           object_text_missing       = 0",
          "           wrong_indicator           = 0.",
          "    if l_returncode = 'W'.",
          "*     Warnungen könnten sich auf Textangaben beziehen",
          "      loop at l_err into  l_err_wa",
          "                    where fieldname = 'TEXTIND'    or",
          "                          fieldname = 'NRELTXTSOB' or",
          "                          fieldname = 'NRELTXTELE' or",
          "                          fieldname = 'NRELTXTTXT' or",
          "                          fieldname = 'NRELTXTTAB' or",
          "                          fieldname = 'NRELTXTLNG'.",
          "*       Warnung für Textangabe: Elementtexte können nicht angezeigt",
          "*       werden, Textangaben müssen initialisiert werden",
          "        clear: tnro-textind,    tnro-nreltxttab,",
          "               tnro-nreltxtsob, tnro-nreltxtele,",
          "               tnro-nreltxttxt, tnro-nreltxtlng.",
          "        exit.",
          "      endloop.",
          "    endif.",
          "  endif.",
          "* aktuelles Objekt ins lokale Gedächtnis stellen",
          "  iobject          = tnro.",
          "  iobject-txt      = tnrot-txt.",
          "  iobject-txtshort = tnrot-txtshort.",
          "*   OBJECT unterscheidet Gruppen",
          "  if iobject-nrtab <> space.",
          "",
          "    if iobject-nrfld <> space.",
          "*     Gruppenelementtabelle besitzt ein Nummernkreisfeld",
          "      iobject-nr_fields = '1'.",
          "    else.",
          "*     Gruppenelementtabelle besitzt ext. und int. Nummernkreisfeld",
          "      iobject-nr_fields = '2'.",
          "    endif.",
          "  else.",
          "*   OBJECT unterscheidet nicht nach Gruppen",
          "    iobject-nr_fields = '0'.",
          "  endif.",
          "",
          "  if iobject-dtelsobj = space.",
          "*    ohne Unterobjekt",
          "     case iobject-nr_fields.",
          "        when '0'.",
          "*         ohne Gruppe",
          "          iobject-type = '1'.",
          "        when '1'.",
          "*         mit Gruppe, 1 Intervall",
          "          iobject-type = '2'.",
          "        when '2'.",
          "*         mit Gruppe, 2 Intervalle",
          "          iobject-type = '3'.",
          "     endcase.",
          "  else.",
          "*   mit Unterobjekt",
          "    if iobject-nr_fields = '0'.",
          "*     ohne Gruppe",
          "      iobject-type = '4'.",
          "    else.",
          "*     mit Gruppe",
          "      if iobject-nrsobjfld = space.",
          "*       Gruppe unabhängig vom Unterobjekt",
          "        if iobject-nr_fields = '1'.",
          "          iobject-type = '5'.",
          "        else.",
          "          iobject-type = '6'.",
          "        endif.",
          "      else.",
          "*       Gruppe abhängig vom Unterobjekt",
          "        if iobject-nr_fields = '1'.",
          "          iobject-type = '7'.",
          "        else.",
          "          iobject-type = '8'.",
          "        endif.",
          "      endif.",
          "    endif.",
          "  endif.",
          "* Länge der Nummernkreisnummer über Domäne bestimmen",
          "  perform get_domain",
          "          using    iobject-domlen",
          "          changing iobject-numbertype",
          "                   l_dummytab",
          "                   iobject-numberlength.",
          "* Nametab für Unterobjekt lesen, falls Unterobjekte existieren",
          "* interne Tabelle für späteren Zugriff und Prüfungen aufbauen",
          "  if iobject-dtelsobj ne space.",
          "*   Nametab bestimmen",
          "    perform get_roll",
          "            using    iobject-dtelsobj",
          "            changing iobject-nrobjlen",
          "                     l_domain.",
          "    clear ntb_subobject.",
          "    perform get_elemfield",
          "            using    l_domain",
          "            changing ntb_subobject",
          "                     g_subobj_client_dep.",
          "*   Daten lesen",
          "    perform read_subobjects",
          "            using ntb_subobject-tabname",
          "                  ntb_subobject-fieldname.",
          "  endif.",
          "",
          "* Nametab für Gruppen lesen, falls Objekt nach Gruppen unterscheidet",
          "  if iobject-nrtab <> space.",
          "*   Nametab bestimmen",
          "    perform get_fields.",
          "  endif.",
          "",
          "* Nametab für Elementtexte lesen, falls Objekt Textangaben enthält",
          "  if iobject-textind <> space.",
          "*   Nametab bestimmen",
          "    perform get_elemtext_fields.",
          "  endif.",
          "endfunction."
        ],
        "fingerprint": "e7dc447ea1d635bd85302ecde8b91b6e7e931c2d83d756552a433cbabcd14b9a",
