        "source": [
          "FUNCTION changedocument_close.",
          "*\"----------------------------------------------------------------------",
          "*\"*\"Lokale Schnittstelle:",
          "*\"  IMPORTING",
          "*\"     VALUE(DATE_OF_CHANGE) LIKE  CDHDR-UDATE",
          "*\"     VALUE(OBJECTCLASS) LIKE  CDHDR-OBJECTCLAS",
          "*\"     VALUE(OBJECTID) LIKE  CDHDR-OBJECTID",
          "*\"     VALUE(TCODE) LIKE  CDHDR-TCODE",
          "*\"     VALUE(TIME_OF_CHANGE) LIKE  CDHDR-UTIME",
          "*\"     VALUE(USERNAME) LIKE  CDHDR-USERNAME",
          "*\"     VALUE(OBJECT_CHANGE_INDICATOR) LIKE  CDHDR-CHANGE_IND DEFAULT",
          "*\"       'U'",
          "*\"     VALUE(PLANNED_OR_REAL_CHANGES) LIKE  CDHDR-CHANGE_IND DEFAULT",
          "*\"       SPACE",
          "*\"     VALUE(NO_CHANGE_POINTERS) LIKE  CDHDR-CHANGE_IND DEFAULT SPACE",
          "*\"  EXPORTING",
          "*\"     VALUE(CHANGENUMBER) LIKE  CDHDR-CHANGENR",
          "*\"  EXCEPTIONS",
          "*\"      HEADER_INSERT_FAILED",
          "*\"      NO_POSITION_INSERTED",
          "*\"      OBJECT_INVALID",
          "*\"      OPEN_MISSING",
          "*\"      POSITION_INSERT_FAILED",
          "*\"----------------------------------------------------------------------",
          "",
          "  IF sequence = space.",
          "    CLEAR: aendnr.",
          "*    Es wurde kein OPEN durchgefuehrt",
          "    MESSAGE e327 WITH 'OPEN_MISSING' 'CDOK' RAISING open_missing.",
          "* 327 Fehler bei Änderungsbelegerstellung oder -auswertung: & &",
          "  ENDIF.",
          "",
          "  IF objektklasse NE objectclass OR objektid NE objectid.",
          "    CLEAR: aendnr, sequence.",
          "*    Beim OPEN wurde eine andere Ojektauspraegung angegeben",
          "    MESSAGE e327 WITH 'OBJECT_INVALID' 'CDOK'",
          "                 RAISING object_invalid.",
          "* 327 Fehler bei Änderungsbelegerstellung oder -auswertung: & &",
          "  ENDIF.",
          "",
          "  IF anz_insert = 0.",
          "*    Es wurden keine Positionen erfasst",
          "    CLEAR: aendnr, sequence.",
          "    MESSAGE e327 WITH 'NO_POSITION_INSERTED' 'CDOK'",
          "                 RAISING no_position_inserted.",
          "* 327 Fehler bei Änderungsbelegerstellung oder -auswertung: & &",
          "  ENDIF.",
          "",
          "* verhindere Abbruch 'SAPSQL_ARRAY_INSERT_DUPREC' in CDPOS/*_UID/*_STR",
          "  PERFORM prevent_duplicates USING    objectclass",
          "                                      objectid",
          "                             CHANGING ins_cdpos[]",
          "                                      gt_cdpos_uid[]",
          "                                      gt_cdpos_str[].",
          "",
          "* Aenderungsbelegnummer exportieren und fuer Folgeaufrufe initialisieren",
          "  changenumber =  changenr_old = aendnr.",
          "  CLEAR: aendnr, sequence.",
          "",
          "* Aenderungsbelegkopf füllen",
          "  gs_cdhdr-objectclas  = objectclass.",
          "  gs_cdhdr-objectid    = objectid.",
          "  gs_cdhdr-changenr    = changenumber.",
          "  gs_cdhdr-username    = username.",
          "  gs_cdhdr-udate       = date_of_change.",
          "  gs_cdhdr-utime       = time_of_change.",
          "  gs_cdhdr-tcode       = tcode.",
          "  gs_cdhdr-planchngnr  = plan_number_act.                   \"B20K022940",
          "  gs_cdhdr-change_ind  = object_change_indicator.           \"B20K020444",
          "  gs_cdhdr-was_plannd  = cd_is_generated.                   \"B20K020812",
          "* Ab UNICODE fuelle die Sprache",
          "  gs_cdhdr-langu = sy-langu.                                \"B5AK006973",
          "",
          "* set CDHDR-VERSION in gs_cdhdr-version",
          "  PERFORM set_version CHANGING gs_cdhdr-version.",
          "",
          "  IF plan_number = space.",
          "* write normal change docu and inform SWE (workflow)",
          "    PERFORM write_normal_changedocu USING gs_cdhdr",
          "                                          ins_cdpos[]",
          "                                          gt_cdpos_uid[]",
          "                                          gt_cdpos_str[].",
          "  ELSE.",
          "* write planned change docu",
          "    PERFORM write_planned_changedocu USING gs_cdhdr",
          "                                           ins_cdpos[]",
          "                                           gt_cdpos_uid[]",
          "                                           gt_cdpos_str[].",
          "  ENDIF.",
          "",
          "  IF no_change_pointers IS INITIAL.",
          "*    inform SMD (change pointers)",
          "    PERFORM sent_to_changepointers USING gs_cdhdr",
          "                                         ins_cdpos[]",
          "                                         gt_cdpos_uid[]",
          "                                         gt_cdpos_str[].",
          "  ENDIF.",
          "* nach dem Schreiben lösche interne Bereiche",
          "  CLEAR: anz_insert, gs_cdhdr, ins_cdpos[],",
          "         gt_cdpos_uid[], gt_cdpos_str[].",
          "ENDFUNCTION."
        ],
